name1=input("enter the first name")
name2=input("enter the second name")
name1=name1.lower()
name2=name2.lower()
name3=name1+name2
a=name3.count('t')
b=name3.count('r')
c=name3.count('u')
d=name3.count('e')
first_digit=a+b+c+d
e=name3.count('l')
f=name3.count('o')
g=name3.count('v')
second_digit=e+f+g+d
print("your love percentage is calculated")
l=str(first_digit)+str(second_digit)
love=int(l)

if love>90 or love<10:
    print("your love is like coke and mentos it's a blast")

if love<50 and love>40:
    print("average love")

print("your love is ",love,"%")
